# Legacy fallback only: ignored whenever the corresponding JSON configuration file exists.
# Server only. Install as /etc/sachi/resource-proxy.env, owned by root, mode 0600.
# Replace the root and gateway with verified production settings.
SACHI_DEPLOY_ROOT=/srv/sachi-blog
SACHI_RESOURCE_PORT=19092
YANDU_GATEWAY=http://127.0.0.1:19091
YANDU_PROJECT_ID=replace-with-dedicated-project-id
# Use a NEW project credential with read scope only. Never copy the upload key.
YANDU_READ_KEY=replace-with-server-read-only-key
