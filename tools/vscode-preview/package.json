{
  "name": "sachi-blog-preview",
  "displayName": "Sachi Blog 文章预览",
  "description": "使用 Sachi Blog 真实排版，实时预览未保存的文章与图文环绕。",
  "version": "0.4.1",
  "type": "module",
  "publisher": "sachi-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "blog",
    "sachi",
    "preview"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "sachiPreview.open",
        "title": "打开文章预览",
        "category": "Sachi Blog",
        "icon": "$(open-preview)"
      },
      {
        "command": "sachiPreview.refresh",
        "title": "刷新文章预览",
        "category": "Sachi Blog",
        "icon": "$(refresh)"
      },
      {
        "command": "sachiPreview.revealLine",
        "title": "定位当前编辑行",
        "category": "Sachi Blog"
      },
      {
        "command": "sachiPreview.toggleLayout",
        "title": "切换桌面宽度／响应式预览",
        "category": "Sachi Blog"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sachiPreview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "sachiPreview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sachiPreview.open",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == markdown && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Sachi Blog 文章预览",
      "properties": {
        "sachiPreview.debounceMs": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "maximum": 2000,
          "description": "输入停止后等待多少毫秒再刷新预览。"
        },
        "sachiPreview.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "预览跟随当前打开的博客文章；关闭后固定当前文章。"
        },
        "sachiPreview.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "预览跟随编辑器的光标定位和滚动；预览中的手动阅读、图片拖动保持独立。"
        },
        "sachiPreview.clickToSource": {
          "type": "boolean",
          "default": true,
          "description": "单击预览文字或非互动图片，将编辑器光标移到对应源码。"
        },
        "sachiPreview.layoutMode": {
          "type": "string",
          "enum": [
            "responsive",
            "desktop"
          ],
          "default": "responsive",
          "description": "默认跟随面板宽度；桌面模式使用 720px 正文，窄面板可横向滚动。"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs",
    "package": "npm exec --yes --package=@vscode/vsce@4.0.0 -- vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out dist/sachi-blog-preview.vsix"
  }
}
